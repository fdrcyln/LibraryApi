pipeline {
    agent any

    stages {
        stage('Select Environment') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'develop') {
                        env.TARGET_NAMESPACE = 'library-dev'
                        env.IMAGE_TAG = "dev-${env.BUILD_NUMBER}"
                        env.API_HOST_PORT = '8082'
                    }
                    else if (env.BRANCH_NAME == 'qa') {
                        env.TARGET_NAMESPACE = 'library-qa'
                        env.IMAGE_TAG = "qa-${env.BUILD_NUMBER}"
                        env.API_HOST_PORT = '8083'
                    }
                    else if (env.BRANCH_NAME == 'main') {
                        env.TARGET_NAMESPACE = 'library-prod'
                        env.IMAGE_TAG = "prod-${env.BUILD_NUMBER}"
                        env.API_HOST_PORT = '8084'
                    }
                    else {
                        error("Unsupported branch: ${env.BRANCH_NAME}")
                    }
                }
            }
        }

        stage('Show Environment') {
            steps {
                echo "Branch: ${env.BRANCH_NAME}"
                echo "Namespace: ${env.TARGET_NAMESPACE}"
                echo "Image Tag: ${env.IMAGE_TAG}"
                echo "API Port: ${env.API_HOST_PORT}"
            }
        }
    }
}